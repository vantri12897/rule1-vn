# ===== Supabase (Project Settings > API) =====
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
# Khoá bí mật — CHỈ đặt ở server (Vercel Environment Variables), không chia sẻ
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ===== Google Gemini (miễn phí tại https://aistudio.google.com/apikey) =====
GEMINI_API_KEY=AIza...
# Tuỳ chọn: tên model (có thể liệt kê nhiều, cách nhau dấu phẩy). Bỏ trống = tự chọn model Flash miễn phí.
GEMINI_MODEL=

# ===== Tuỳ chọn: bảo vệ endpoint giữ Supabase không bị tạm dừng =====
CRON_SECRET=
